<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Configurations>Debug;Release</Configurations>

        <!--Mod version; keep ModVersion in PublishConfiguration.xml equal (checked on build)-->
        <Version>0.11.0</Version>

        <!--The file where mod information which is required for publishing mod on PDX mods are stored-->
        <PublishConfigurationPath>Properties\PublishConfiguration.xml</PublishConfigurationPath>
    </PropertyGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>BuildTimeUtc</_Parameter1>
            <_Parameter2>$([System.DateTime]::UtcNow.ToString("yyyy-MM-dd HH:mm:ss"))</_Parameter2>
        </AssemblyAttribute>
    </ItemGroup>

    <Target Name="CheckModVersionInSync" BeforeTargets="BeforeBuild">
        <XmlPeek XmlInputPath="$(PublishConfigurationPath)" Query="/Publish/ModVersion/@Value">
            <Output TaskParameter="Result" PropertyName="PublishedModVersion" />
        </XmlPeek>
        <Error Condition="'$(PublishedModVersion)' != '$(Version)'"
               Text="Version mismatch: Unsquare.csproj has $(Version), $(PublishConfigurationPath) has ModVersion $(PublishedModVersion). Bump both together." />
    </Target>

    <!--Imports must be after PropertyGroup block-->
    <Import Project="$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))\Mod.props"/>
    <Import Project="$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))\Mod.targets"/>

    <ItemGroup>
        <Reference Include="Game">
            <Private>false</Private>
        </Reference>
        <Reference Include="Colossal.Core">
            <Private>false</Private>
        </Reference>
        <Reference Include="Colossal.Logging">
            <Private>false</Private>
        </Reference>
        <Reference Include="Colossal.IO.AssetDatabase">
            <Private>false</Private>
        </Reference>
        <Reference Include="Colossal.AssetPipeline">
            <Private>false</Private>
        </Reference>
        <Reference Include="Colossal.Mathematics">
            <Private>false</Private>
        </Reference>
        <Reference Include="Colossal.PSI.Common">
            <Private>false</Private>
        </Reference>
        <Reference Include="Colossal.Localization">
            <Private>false</Private>
        </Reference>
        <Reference Include="Colossal.UI.Binding">
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <Private>false</Private>
        </Reference>
        <Reference Include="Unity.Burst">
            <Private>false</Private>
        </Reference>
        <Reference Include="Unity.Collections">
            <Private>false</Private>
        </Reference>
        <Reference Include="Unity.Entities">
            <Private>false</Private>
        </Reference>
        <Reference Include="Unity.Mathematics">
            <Private>false</Private>
        </Reference>
        <Reference Include="Newtonsoft.Json">
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <Reference Update="System">
            <Private>false</Private>
        </Reference>
        <Reference Update="System.Core">
            <Private>false</Private>
        </Reference>
        <Reference Update="System.Data">
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <!--The bottom-bar button is a UI module (UiModule/, webpack writes into Mods\Unsquare); it must run after
        DeployWIP, which deletes the deploy folder. Skip with -p:SkipUiModule=true (e.g. without Node.js).-->
    <PropertyGroup>
        <UiModuleDir>$(MSBuildProjectDirectory)\..\UiModule</UiModuleDir>
    </PropertyGroup>
    <Target Name="BuildUiModule" AfterTargets="DeployWIP" Condition="'$(NeedBuild)' == 'true' and '$(SkipUiModule)' != 'true'">
        <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(UiModuleDir)" Condition="!Exists('$(UiModuleDir)\node_modules')" />
        <Exec Command="npm run build" WorkingDirectory="$(UiModuleDir)" />
    </Target>
    <Target Name="WarnUiModuleSkipped" AfterTargets="DeployWIP" Condition="'$(NeedBuild)' == 'true' and '$(SkipUiModule)' == 'true'">
        <Warning Text="UI module skipped: $(DeployDir) has no UI files, so the Unsquare button is missing in game." />
    </Target>

    <!--A running game locks the DLL, and DeployWIP would delete every other deployed file (incl. the UI module)
        before failing. Stop before it so the deployed mod stays intact.-->
    <Target Name="CheckGameNotRunning" BeforeTargets="DeployWIP" Condition="'$(NeedBuild)' == 'true'">
        <Exec Command="tasklist /NH /FI &quot;IMAGENAME eq Cities2.exe&quot; | findstr /I Cities2.exe" IgnoreExitCode="true"
              EchoOff="true" StandardOutputImportance="low">
            <Output TaskParameter="ExitCode" PropertyName="GameRunningCheck" />
        </Exec>
        <Error Condition="'$(GameRunningCheck)' == '0'"
               Text="Close Cities: Skylines II before building: the deploy replaces $(DeployDir) and the game locks the mod DLL." />
    </Target>

    <ItemGroup>
        <None Include="$(ModPropsFile)" Link="Properties\Mod.props"/>
        <None Include="$(ModTargetsFile)" Link="Properties\Mod.targets"/>
    </ItemGroup>

</Project>
